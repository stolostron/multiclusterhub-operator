FROM registry.ci.openshift.org/stolostron/builder:go1.26-linux AS builder

# Install ginkgo from the module's pinned version (go.mod/go.sum enforce the exact version)
# and yq with GONOSUMDB=off to enforce checksum verification for both tools
RUN GONOSUMDB=off go install github.com/onsi/ginkgo/v2/ginkgo && \
    GONOSUMDB=off go install github.com/mikefarah/yq/v3@v3.0.0-20201202084205-8846255d1c37

ENV KUBECONFIG "/opt/.kube/config"
COPY . /src/github.com/stolostron/multiclusterhub-operator

WORKDIR /src/github.com/stolostron/multiclusterhub-operator

USER 65532:65532

ENTRYPOINT [ "./test/function_tests/start-tests.sh" ]
