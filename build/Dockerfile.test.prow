FROM registry.ci.openshift.org/stolostron/builder:go1.26-linux AS builder

# Install ginkgo and yq from go.mod/go.sum pinned versions (tools/tools.go enforces lock-file tracking)
RUN GONOSUMDB=off go install github.com/onsi/ginkgo/v2/ginkgo && \
    GONOSUMDB=off go install github.com/mikefarah/yq/v3

ENV KUBECONFIG "/opt/.kube/config"
COPY . /src/github.com/stolostron/multiclusterhub-operator # NOSONAR - test-only image; full source tree required for function tests

WORKDIR /src/github.com/stolostron/multiclusterhub-operator

USER 65532:65532

ENTRYPOINT [ "./test/function_tests/start-tests.sh" ]
